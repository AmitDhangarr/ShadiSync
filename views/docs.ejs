        <tr><td data-label="Method"><span class="method get">GET</span></td><td data-label="Path"><span class="param">:eventId</span><code>/guest/</code><span class="param">:guestname</span></td><td data-label="Purpose">Look up gifts logged by a specific guest.</td></tr>
