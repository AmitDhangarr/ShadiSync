  <section class="module" id="guest-gift">
    <h2>Guest · Gift Registry</h2>
    <p class="module-desc">Register a gift you're giving to the couple/host - cash, a physical item, gold, or a voucher.</p>
    <div class="module-meta"><span class="tag strong">Login required</span><span class="tag">Multipart upload on create</span></div>
    <div class="base-path">/api/v1/guest/gift</div>
    <table class="routes">
      <thead><tr><th>Method</th><th>Path</th><th>Purpose &amp; fields</th></tr></thead>
      <tbody>
        <tr><td data-label="Method"><span class="method get">GET</span></td><td data-label="Path"><code>/</code></td><td data-label="Purpose">List gift registries grouped by event.</td></tr>
        <tr>
          <td data-label="Method"><span class="method post">POST</span></td>
          <td data-label="Path"><span class="param">:eventId</span><code>/register</code></td>
          <td data-label="Purpose">Register a new gift. Send as <code>multipart/form-data</code> to attach a <code>photo</code>.
            <span class="body-label">Body</span>
            <ul class="field-list">
              <li><code>guest_name</code>, <code>guest_family</code></li>
              <li><code>mobile_number</code> — valid Indian mobile number</li>
              <li><code>role</code> — <code>guest / co-host / host</code></li>
              <li><code>gift_type</code> — <code>Cash / Gift Item / Gold / Voucher</code></li>
              <li><code>shagun_amount</code> — number</li>
              <li><code>gift_item_name</code>, <code>gift_description</code></li>
              <li><code>function_name</code> — <code>Engagement / Haldi / Mehndi / Sangeet / Wedding / Reception / Other</code></li>
              <li><code>payment_mode</code> — <code>Cash / UPI / Cheque / Bank Transfer / Other</code></li>
              <li><code>transaction_reference</code>, <code>envelope_number</code></li>
              <li><code>received_by</code>, <code>received_at</code> — ISO date</li>
              <li><code>notes</code>, <code>thank_you_sent</code>, <code>return_gift_given</code> — booleans</li>
            </ul>
          </td>
        </tr>
        <tr><td data-label="Method"><span class="method get">GET</span></td><td data-label="Path"><span class="param">:eventId</span><code>/all</code></td><td data-label="Purpose">List all your gift registrations for an event.</td></tr>
        <tr><td data-label="Method"><span class="method get">GET</span></td><td data-label="Path"><span class="param">:eventId</span>/<span class="param">:id</span></td><td data-label="Purpose">Get one gift registration.</td></tr>
        <tr>
          <td data-label="Method"><span class="method patch">PATCH</span></td>
          <td data-label="Path"><span class="param">:eventId</span>/<span class="param">:id</span></td>
          <td data-label="Purpose">Update a gift registration. Only these fields can change: <code>guest_name, guest_family, mobile_number, role, gift_type, shagun_amount, gift_item_name, gift_description, payment_mode, transaction_reference, notes, photo</code>.</td>
        </tr>
        <tr><td data-label="Method"><span class="method delete">DELETE</span></td><td data-label="Path"><span class="param">:eventId</span>/<span class="param">:id</span></td><td data-label="Purpose">Remove a gift registration.</td></tr>
      </tbody>
    </table>
    <p class="note"><span class="flag">Note</span>The route <code>/guest/expense</code> exists in the codebase but currently points to the account password-update handler rather than a working expense feature — treat it as not yet implemented.</p>
  </section>

